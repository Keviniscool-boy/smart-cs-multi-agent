OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=
# Change to 8081 if port 8080 is already in use.
FRONTEND_PORT=8080
# Embedding：二选一。
# 1) 设置 DASHSCOPE_API_KEY -> 走阿里云 DashScope 原生接口；
# 2) 留空 -> 复用上面的 OPENAI_BASE_URL / OPENAI_API_KEY，走任何
#    OpenAI 兼容的 /embeddings 服务（EMBEDDING_MODEL 换成该服务的模型名）。
# 注意：更换 embedding 模型/提供商后必须删除 vector_store/ 重建索引
#（程序会自动检测并提示）。
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
REDIS_URL=redis://localhost:6379/0
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=smart_cs_app
# 必填（B4）：无默认值；compose 在未设置时会直接报错退出
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# 存量部署迁移（PR: Harden authentication and deployment defaults）：
# 1) 已初始化的 mysql_data 卷不会因改 MYSQL_ROOT_PASSWORD 而改密——root 密码保持首次初始化时的值；
# 2) 旧卷不会自动创建应用账号 smart_cs_app，需用 root 手动执行：
#    CREATE USER 'smart_cs_app'@'%' IDENTIFIED BY '<MYSQL_PASSWORD 的值>';
#    GRANT SELECT, INSERT, UPDATE, DELETE, CREATE ON smart_cs.* TO 'smart_cs_app'@'%';
#    FLUSH PRIVILEGES;
MYSQL_DATABASE=smart_cs
# 必填（B1）：无默认值、不允许历史占位值；缺失时应用拒绝启动
JWT_SECRET_KEY=
# 可选（B10）：生产 https 环境必须置 true，使 auth Cookie 带 Secure 标记
# Set COOKIE_SECURE=false only for local HTTP development.
COOKIE_SECURE=true
JWT_EXPIRE_MINUTES=60
# 可选：演示订单与售后 SQLite 路径，默认为 data/after_sales.sqlite3。
# 相对路径以项目根目录为基准。
# AFTER_SALES_DB_PATH=data/after_sales.sqlite3
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# 可选（B5）：逗号分隔的前端来源白名单，默认仅本地前端
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:5173
# 可选（B15）：评测脚本密码，不再入库明文
EVAL_PASSWORD=
